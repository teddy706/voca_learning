# Supabase 프로젝트: reading-buddy와 공유. 값은 reading-buddy/.env.local에서 그대로 복사할 것 —
# 절대 새로 발급하거나 다른 값을 넣지 말 것(다른 프로젝트가 아니라 같은 프로젝트를 공유하는 것).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. legacy JWT 형식이어야 함(sb_secret_... 새 형식은 admin.from().insert()가 permission denied).
SUPABASE_SERVICE_ROLE_KEY=

# ⚠️ reading-buddy와 정확히 동일한 값이어야 자녀 PIN 로그인이 기존 synthetic 계정에 붙는다.
CHILD_AUTH_SECRET=

# --- Azure AI Document Intelligence (단어장 사진 OCR) ---
# 리딩버디의 reading-buddy-docintel 리소스를 재사용하거나, 별도 리소스 생성 시 그 값으로 교체.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Azure Blob Storage (단어장 사진 원본 저장) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=vocab-photos
